# PostgreSQL local instance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nbptracker
POSTGRES_USER=nbptracker
POSTGRES_PASSWORD=

# NBP API — no auth required, but custom User-Agent recommended
NBP_USER_AGENT=nbptracker/0.1 by KarolMasiak

# Telegram alerts (optional — alerts work without them, just no push notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
